@page "/products/{Id:int}"
@using blazor_app.Interfaces
@using blazor_app.Models
@using blazor_app.Utils
@inject IProductService ProductService

<PageTitle>@(Product is null ? "Sản phẩm" : Product.Name)</PageTitle>

@if (Product is null)
{
    <div class="container py-5 text-center">
        <p class="text-secondary mb-2">Không tìm thấy sản phẩm.</p>
        <a class="link-dark link-underline-opacity-0 link-underline-opacity-100-hover" href="/">← Về trang chủ</a>
    </div>
}
else
{
    <div class="container py-4">
        @if (Added == 1)
        {
            <div class="alert alert-success" role="alert">
                Đã thêm sản phẩm vào giỏ hàng.
            </div>
        }

        <div class="row g-4">
            <div class="col-12 col-lg-7">
                <div class="d-flex align-items-start gap-2">
                    <div class="flex-grow-1 ratio ratio-1x1 bg-body-secondary rounded overflow-hidden">
                        @if (ImageUrlHelper.ForFirst(ProductImages) is string mainUrl)
                        {
                            <img class="object-fit-contain" src="@mainUrl" alt="@Product.Name" />
                        }
                    </div>

                    @if (ProductImages.Count > 1)
                    {
                        <div class="d-flex flex-column gap-2 w-25">
                            @foreach (var image in ProductImages.Skip(1).Take(2))
                            {
                                <div class="ratio ratio-1x1 bg-body-secondary rounded overflow-hidden">
                                    <img class="object-fit-cover" src="@ImageUrlHelper.For(image)" alt="@Product.Name" loading="lazy" />
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="col-12 col-lg-5">
                <div class="d-flex flex-column gap-3">
                    <div>
                        <p class="small text-secondary mb-1">@Product.Brand.Label</p>
                        <h1 class="fs-3 fw-bold mb-2">@Product.Name</h1>
                        <p class="small text-secondary mb-1">@Product.Category.Label - @Product.Team.Label</p>
                        @if (!string.IsNullOrWhiteSpace(Product.Season?.Name))
                        {
                            <p class="small text-secondary mb-1">Mùa giải: @Product.Season.Name</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(Product.KitType?.Label))
                        {
                            <p class="small text-secondary mb-0">Loại áo: @Product.KitType.Label</p>
                        }
                    </div>

                    <div class="d-flex align-items-baseline flex-wrap gap-2">
                        @if (Product.OldPrice is decimal oldPrice && oldPrice > Product.Price)
                        {
                            <span class="fs-6 text-secondary text-decoration-line-through">@PriceFormatter.Format(oldPrice)</span>
                        }
                        <span class="fs-4 fw-bold">@PriceFormatter.Format(Product.Price)</span>
                        @if (ProductDisplay.DiscountPercent(Product.Price, Product.OldPrice) is int discount)
                        {
                            <span class="badge text-bg-primary">-@(discount)%</span>
                        }
                    </div>

                    <form method="post" action="/cart/add" class="d-flex flex-column gap-3 pt-2">
                        <input type="hidden" name="productId" value="@Product.Id" />

                        <div>
                            <p class="form-label fw-semibold mb-2">Size</p>
                            <div class="d-flex flex-wrap gap-2" role="group" aria-label="Chọn size">
                                @foreach (var size in Enum.GetValues<Size>())
                                {
                                    <input class="btn-check" type="radio" name="size" id="size-@size" value="@size"
                                           checked="@(size == Size.S)" />
                                    <label class="btn btn-outline-dark" for="size-@size">@size</label>
                                }
                            </div>
                        </div>

                        <div>
                            <label class="form-label fw-semibold" for="quantity">Số lượng</label>
                            <div class="row g-2">
                                <div class="col-4 col-sm-3">
                                    <input class="form-control" type="number" id="quantity" name="quantity"
                                           min="1" max="99" value="1" />
                                </div>
                            </div>
                        </div>

                        <button class="btn btn-dark w-100" type="submit">Thêm vào giỏ</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <section class="container py-4">
        <h2 class="fs-4 fw-bold mb-3">Sản phẩm liên quan</h2>

        @if (Related.Count == 0)
        {
            <p class="text-secondary mb-0">Chưa có sản phẩm nào.</p>
        }
        else
        {
            <div class="d-flex gap-3 overflow-auto pb-2">
                @foreach (var relatedProduct in Related)
                {
                    <a class="card flex-shrink-0 border-0 bg-transparent text-body text-decoration-none product-rail-card"
                       href="/products/@relatedProduct.Id">
                        <div class="ratio ratio-1x1 bg-body-secondary">
                            @if (ImageUrlHelper.ForFirst(relatedProduct.Images) is string imageUrl)
                            {
                                <img class="object-fit-cover" src="@imageUrl" alt="@relatedProduct.Name" loading="lazy" />
                            }
                        </div>
                        <div class="card-body p-2 d-flex flex-column gap-1">
                            <h3 class="card-title fs-6 fw-normal lh-sm mb-0 text-truncate">@relatedProduct.Name</h3>
                            <div class="d-flex align-items-baseline gap-2">
                                @if (relatedProduct.OldPrice is decimal relatedOldPrice && relatedOldPrice > relatedProduct.Price)
                                {
                                    <span class="small text-secondary text-decoration-line-through">@PriceFormatter.Format(relatedOldPrice)</span>
                                }
                                <span class="fw-bold">@PriceFormatter.Format(relatedProduct.Price)</span>
                            </div>
                        </div>
                    </a>
                }
            </div>
        }
    </section>
}

@code {
    private Product? Product { get; set; }
    private IReadOnlyList<Product> Related { get; set; } = Array.Empty<Product>();

    [Parameter] public int Id { get; set; }

    [SupplyParameterFromQuery(Name = "added")]
    public int? Added { get; set; }

    private List<ProductImage> ProductImages =>
        Product?.Images?.OrderBy(image => image.SortOrder).ToList() ?? new List<ProductImage>();

    protected override async Task OnInitializedAsync()
    {
        Product = await ProductService.GetByIdAsync(Id);
        if (Product is not null)
        {
            Related = await ProductService.GetRelatedAsync(Id, 10);
        }
    }
}
